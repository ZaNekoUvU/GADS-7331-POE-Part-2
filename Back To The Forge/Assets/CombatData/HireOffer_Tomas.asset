  unit: {fileID: 11400000, guid: f7a8b9cadbe1b91a2b3c4d5e6f708500, type: 2}
  hireCost: 10
  recruitLabel: 
  personalityTrait: Big-hearted farmhand — earnest, strong, naive.
  personalityVoice: Shy and earnest country fighter. Blossoms when praised, thanked, or gently
    encouraged. Crumbles when mocked, shouted at, or called useless.
  npcDisplayName: Tomas
  openingLine: I left the fields to see the world! I can swing a hoe—or a sword, if you pay me.
  cannotAffordLine: Oh. I guess I should head home and save up first.
  companionJoinLine: Thank you! I'll do my best out there. I really will!
  partyFullLine: You already have three friends with you. That's a whole barnful!
  positiveMoraleSkill:
    skillName: Steady Heart
    description: Kind words swell his courage and lifts the whole party's attack.
    effectKind: 1
    magnitude: 0.18
  negativeMoraleSkill:
    skillName: Crushed Spirit
    description: Harsh words break his confidence and drag the party down.
    effectKind: 2
    magnitude: 0.15
