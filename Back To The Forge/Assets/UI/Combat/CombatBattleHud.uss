/* Final Fantasy I–style battle command bar */

.battle-hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 28%;
    min-height: 140px;
    max-height: 220px;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    padding: 6px 8px 10px 8px;
    background-color: rgba(0, 0, 0, 0.15);
}

.hud-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-left: 4px;
    margin-right: 4px;
    padding: 10px 12px;
    background-color: rgb(0, 0, 128);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
}

.hud-panel--commands {
    flex-grow: 1.1;
    max-width: 220px;
}

.unit-list {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
}

.unit-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 2px;
    padding-bottom: 2px;
    min-height: 22px;
}

.unit-row--active {
    background-color: rgba(255, 255, 255, 0.22);
}

.unit-row--defeated {
    opacity: 0.45;
}

.unit-name {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    margin-right: 8px;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

.unit-hp {
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: normal;
    flex-shrink: 0;
    min-width: 72px;
    -unity-text-align: middle-right;
}

.enemy-name-only {
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    padding-top: 3px;
    padding-bottom: 3px;
}

.command-list {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
}

.command-row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    padding-left: 4px;
    padding-right: 4px;
}

.command-row--selected {
    background-color: rgba(255, 255, 255, 0.25);
}

.command-cursor {
    width: 18px;
    color: rgb(255, 255, 255);
    font-size: 14px;
    visibility: hidden;
}

.command-row--selected .command-cursor {
    visibility: visible;
}

.command-label {
    color: rgb(255, 255, 255);
    font-size: 17px;
    -unity-font-style: bold;
}

.command-row--disabled .command-label {
    color: rgb(160, 160, 200);
}

.command-row--disabled .command-cursor {
    visibility: hidden;
}
