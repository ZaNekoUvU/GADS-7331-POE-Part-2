/* Final Fantasy I–style battle command bar */

.battle-hud {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34%;
    min-height: 168px;
    max-height: 280px;
    flex-direction: row;
    align-items: stretch;
    justify-content: center;
    padding: 6px 8px 10px 8px;
    background-color: rgba(0, 0, 0, 0.15);
}

.hud-panel {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    margin-left: 4px;
    margin-right: 4px;
    padding: 6px 8px;
    background-color: rgb(0, 0, 128);
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
}

/* Quest log + gather prompt only — semi-transparent so the world shows through. */
.hud-panel.hud-panel--faded {
    background-color: rgba(0, 0, 128, 0.45);
    border-color: rgba(255, 255, 255, 0.65);
}

.hud-panel--commands {
    flex-grow: 1.1;
    max-width: 220px;
}

.hud-panel--allies {
    flex-grow: 1.2;
    max-width: 210px;
    min-width: 150px;
}

.hud-panel.pickup-log-entry {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    margin-left: 0;
    margin-right: 0;
    margin-top: 4px;
    min-height: 34px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 8px 12px;
    overflow: hidden;
}

.pickup-log-entry .pickup-log-label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.unit-list {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
}

.unit-stats-row {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.unit-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 0;
    padding-bottom: 0;
    min-height: 14px;
    flex-shrink: 0;
}

.unit-row--active {
    background-color: rgba(255, 255, 255, 0.22);
}

.unit-row--defeated {
    opacity: 0.45;
}

.unit-name {
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-font-style: bold;
    margin-right: 4px;
    flex-shrink: 1;
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.unit-hp {
    color: rgb(255, 255, 255);
    font-size: 9px;
    -unity-font-style: normal;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
}

.unit-mp {
    color: rgb(255, 255, 255);
    font-size: 9px;
    -unity-font-style: normal;
    flex-shrink: 0;
    margin-left: 6px;
}

.enemy-name-only {
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-style: bold;
    padding-top: 1px;
    padding-bottom: 1px;
}

.command-list {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
}

.command-row {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    padding-left: 4px;
    padding-right: 4px;
}

.command-row--selected {
    background-color: rgba(255, 255, 255, 0.25);
}

.command-cursor {
    width: 18px;
    color: rgb(255, 255, 255);
    font-size: 14px;
    visibility: hidden;
}

.command-row--selected .command-cursor {
    visibility: visible;
}

.command-label {
    color: rgb(255, 255, 255);
    font-size: 17px;
    -unity-font-style: bold;
}

.command-row--disabled .command-label {
    color: rgb(160, 160, 200);
}

.command-row--disabled .command-cursor {
    visibility: hidden;
}

/* Companion reply field (party merc chat — same dialogue panel as NPC talk) */
.companion-dialogue-input-row {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    padding-top: 6px;
    border-top-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.35);
}

.companion-dialogue-input {
    flex-grow: 1;
    min-height: 24px;
    background-color: rgba(0, 0, 64, 0.55);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.75);
    border-radius: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: normal;
    padding-left: 8px;
    padding-right: 8px;
}

.companion-dialogue-input > TextInput {
    background-color: transparent;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: normal;
    padding-left: 0;
    padding-right: 0;
}

.companion-dialogue-input .unity-text-field__input {
    background-color: transparent;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
}
