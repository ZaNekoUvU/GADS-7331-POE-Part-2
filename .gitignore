# Unity + GitHub — works when the project lives in a subfolder (e.g. "Back To The Forge/")
# Based on: https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Leading "**/" so Library/Temp/Logs/etc. are ignored under any project path, not only repo root.

.utmp/

# AI gateway backend
ai-server/bin/
ai-server/obj/
ai-server/appsettings.Local.json

# Unity generated folders
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/

*.log

# Blender sidecar files (not needed in version control)
*.blend1
*.blend1.meta

# MemoryCaptures can be huge and may contain sensitive data
**/[Mm]emoryCaptures/

# Recordings can be huge
**/[Rr]ecordings/

# Optional: Asset Store plugin (uncomment if you use it)
# **/[Aa]ssets/AssetStoreTools*

# JetBrains Rider — generated editor plugin under Assets
**/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# IDE / OS noise
.vs/
.vscode/
.idea/
.gradle/
.DS_Store
Thumbs.db
Desktop.ini

# Autogenerated VS / Mono solution files (Unity regenerates these)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

sysinfo.txt
mono_crash.*

# Builds / packages
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

crashlytics-build.properties

# Test Runner
InitTestScene*.unity*

# Addressables / StreamingAssets build output
**/ServerData
**/[Aa]ssets/StreamingAssets/aa*
**/[Aa]ssets/AddressableAssetsData/link.xml*
**/[Aa]ssets/Addressables_Temp*
**/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting generated
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

**/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
**/[Aa]ssets/[Ss]ceneDependencyCache*
